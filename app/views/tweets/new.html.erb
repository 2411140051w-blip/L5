<h3>新規ツイート</h3>
<hr>
<% if @tweet.errors.present? %>
<h3>エラーがあります。</h3>
<ul>
  <% @tweet.errors.full_messages.each do |msg| %>
    <li><%= msg %></li>
  <% end %>
</ul>
<hr>
<% end %>

<%= form_with model: @tweet do |f| %>
  <p>
  <%= f.label :message, 'ツイート' %>
  <%= f.text_field :message %>
  </p>
  <p><%= f.submit '登録' %></p>
  <p><%= link_to '戻る', users_path %></p>
<% end %>