<p>ログイン中のユーザー: <%= session[user_uid] %></p>
<p><%= link_to '削除', user_mgr_user_path %></p>
<hr>
<hr>
<% @tweets.each do |tweet| %>
  <p>投稿者：<%= tweet.user.uid %></p>
  <p>ツイート：<%= tweet.message %></p>
  <%= link_to 'いいね', likes_path(tweet_id: tweet.id), data: { turbo_method: :post } %>
  <%= link_to 'いいね削除', like_path(tweet), data: { turbo_method: :delete } %>
  <p><%= link_to '削除', tweet_path(tweet), data: { turbo_method: :delete } %></p>
  <hr>
<% end %>
<%= link_to '新規追加', new_tweet_path %>
